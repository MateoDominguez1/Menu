# Base de datos. Local: archivo SQLite. Produccion: URL de Turso (libsql://...) + token.
# La integracion de Turso en Vercel inyecta TURSO_DATABASE_URL y TURSO_AUTH_TOKEN (tambien se aceptan).
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Acceso. Si APP_PASSWORD esta vacio, la app no pide clave (solo para uso local).
APP_PASSWORD=
APP_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# IA opcional (generacion de planes). Sin clave, la app usa el motor local.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
